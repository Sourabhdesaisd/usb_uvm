
#
# Preferences
#
preferences set toolbar-Standard-WatchWindow {
  usual
  shown 0
}
preferences set savedlg-dbnames save
preferences set plugin-enable-svdatabrowser-new 1
preferences set toolbar-CursorControl-WaveWindow {
  usual
  position -anchor e
}
preferences set toolbar-Windows-WatchWindow {
  usual
  shown 0
}
preferences set savedlg-forceprompt 1
preferences set toolbar-txe_waveform_toggle-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-SimControl-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-Windows-WaveWindow {
  usual
  position -pos 2
}
preferences set savedlg-simulator ppe
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}

#
# Databases
#
database require wave -search {
	./wave.shm/wave.trn
	/home/sgeuser8/Desktop/usb_phy_sim/sim/wave.shm/wave.trn
}

#
# Markers
#
set time 855ns
if {[catch {marker new -name  {Marker 1} -time $time}] != ""} {
    marker set -using {Marker 1} -time $time
}
set time 19286ns
if {[catch {marker new -name  {Marker 3} -time $time}] != ""} {
    marker set -using {Marker 3} -time $time
}
set time 0.080105ms
if {[catch {marker new -name  {Marker 2} -time $time}] != ""} {
    marker set -using {Marker 2} -time $time
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1366x665+-1+27}] != ""} {
    window geometry "Waveform 1" 1366x665+-1+27
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 134 \
    -units ns \
    -valuewidth 80
waveform baseline set -time 14,820ns

set id [waveform add -signals  {
	wave::tb_top.dut.clk
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_fifo.rst_n
	} ]
set id [waveform add -signals  {
	{wave::tb_top.dut.sie_data[7:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.sie_eop
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.sie_sop
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.sie_valid
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.sof_packet
	} ]
set id [waveform add -signals  {
	{wave::tb_top.dut.usb_speed[1:0]}
	} ]
set id [waveform add -cdivider divider]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.dp
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.dm
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.tx_valid
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.sie_valid
	} ]
set id [waveform add -cdivider divider]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.bit_in
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.bit_in_valid
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.clk
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_line_conv.line_valid
	} ]
set id [waveform add -signals  {
	{wave::tb_top.dut.dut_tx.u_line_conv.line_state[1:0]}
	} ]
set id [waveform add -signals  {
	{wave::tb_top.dut.dut_tx.u_mux.data_line_state[1:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_mux.data_valid
	} ]
set id [waveform add -signals  {
	{wave::tb_top.dut.dut_tx.u_mux.eop_line_state[1:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_mux.eop_valid
	} ]
set id [waveform add -signals  {
	{wave::tb_top.dut.dut_tx.u_mux.tx_line_state[1:0]}
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_mux.tx_valid
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.bit_in_sop
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.bit_tick
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.bit_in_last
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.nrzi_out
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.nrzi_out_last
	} ]
set id [waveform add -signals  {
	wave::tb_top.dut.dut_tx.u_nrzi.nrzi_out_valid
	} ]

waveform xview limits 0 55296ns

