
#
# Preferences
#
preferences set toolbar-Standard-WatchWindow {
  usual
  shown 0
}
preferences set savedlg-dbnames save
preferences set plugin-enable-svdatabrowser-new 1
preferences set toolbar-CursorControl-WaveWindow {
  usual
  position -anchor e
}
preferences set toolbar-Windows-WatchWindow {
  usual
  shown 0
}
preferences set savedlg-forceprompt 1
preferences set toolbar-txe_waveform_toggle-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-SimControl-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-Windows-WaveWindow {
  usual
  position -pos 2
}
preferences set savedlg-simulator ppe
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}

#
# Databases
#
database require wave -search {
	./wave.shm/wave.trn
	/home/sgeuser8/Desktop/usb_phy_sim/sim/wave.shm/wave.trn
}
#
# Groups
#
catch {group new -name TX_IN -overlay 0}
catch {group new -name TX_OUT -overlay 0}
catch {group new -name TX_OUTPUT -overlay 0}
catch {group new -name RX_IN -overlay 0}
catch {group new -name RX_OUT -overlay 0}
catch {group new -name CDR_IN -overlay 0}
catch {group new -name CDR_OUT -overlay 0}
group using TX_IN
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_tx.clk \
    wave::top_tb.dut.dut_tx.rst_n \
    wave::top_tb.dut.dut_tx.sie_data[7:0] \
    wave::top_tb.dut.dut_tx.sie_eop \
    wave::top_tb.dut.dut_tx.sie_sop \
    wave::top_tb.dut.dut_tx.sie_valid \
    wave::top_tb.dut.dut_tx.sof_packet \
    wave::top_tb.dut.dut_tx.usb_speed[1:0] \
    {### cdivider}
group using TX_OUT
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_tx.tx_valid \
    wave::top_tb.dut.dut_tx.sie_ready \
    wave::top_tb.dut.dut_tx.dp \
    wave::top_tb.dut.dut_tx.dm
group using TX_OUTPUT
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_tx.dp \
    wave::top_tb.dut.dut_tx.dm \
    wave::top_tb.dut.dut_tx.sie_ready \
    wave::top_tb.dut.dut_tx.tx_valid
group using RX_IN
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_rx.usb_speed[1:0] \
    wave::top_tb.dut.dut_rx.sample_valid \
    wave::top_tb.dut.dut_rx.d_minus \
    wave::top_tb.dut.dut_rx.d_plus
group using RX_OUT
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_rx.DataOut[7:0] \
    wave::top_tb.dut.dut_rx.LineState[1:0] \
    wave::top_tb.dut.dut_rx.rx_eop \
    wave::top_tb.dut.dut_rx.rx_sop \
    wave::top_tb.dut.dut_rx.RxValid \
    wave::top_tb.dut.dut_rx.RxActive \
    wave::top_tb.dut.dut_rx.RxError \
    wave::top_tb.dut.dut_rx.rx_align_err \
    wave::top_tb.dut.dut_rx.rx_bus_reset \
    wave::top_tb.dut.dut_rx.rx_line_err \
    wave::top_tb.dut.dut_rx.rx_stuff_err \
    wave::top_tb.dut.dut_rx.rx_sync_err
group using CDR_IN
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_cdr.speed[1:0] \
    wave::top_tb.dut.dut_cdr.rx_phy_bfm \
    wave::top_tb.dut.dut_cdr.enable \
    wave::top_tb.dut.dut_cdr.dm \
    wave::top_tb.dut.dut_cdr.dp
group using CDR_OUT
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    wave::top_tb.dut.dut_cdr.recovered_bit_clk \
    wave::top_tb.dut.dut_cdr.dp_out \
    wave::top_tb.dut.dut_cdr.dm_out

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1366x665+-1+27}] != ""} {
    window geometry "Waveform 1" 1366x665+-1+27
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0


set groupId0 [waveform add -groups TX_IN]


set groupId0 [waveform add -groups TX_OUTPUT]

set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups RX_IN]

set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups RX_OUT]

set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups CDR_IN]

set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups CDR_OUT]

set id [waveform add -cdivider divider]
set id [waveform add -signals  {
	wave::top_tb.dut.analog_d_minus
	} ]
set id [waveform add -signals  {
	wave::top_tb.dut.analog_d_plus
	} ]
set id [waveform add -signals  {
	wave::top_tb.dut.analog_enable
	} ]
set id [waveform add -signals  {
	wave::top_tb.dut.analog_phy_bfm
	} ]
set id [waveform add -signals  {
	{wave::top_tb.dut.DataOut[7:0]}
	} ]
set id [waveform add -signals  {
	wave::top_tb.dut.RxValid
	} ]
set id [waveform add -signals  {
	wave::top_tb.dut.RxActive
	} ]

waveform xview limits 0 275719ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+38+66

